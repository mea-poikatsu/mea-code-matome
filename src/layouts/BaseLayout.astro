---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = SITE.description, canonicalPath = '/', ogImage = '/images/ogp.jpg', jsonLd, noindex = false } = Astro.props;
const canonical = SITE.siteUrl + canonicalPath;
const ogImageUrl = SITE.siteUrl + ogImage;
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'メアのポイ活メディア',
  url: 'https://mea-poikatsu.github.io/mea-poikatsu-media/',
  sameAs: [
    'https://x.com/pppppuririn',
    'https://note.com/k_n702',
    'https://lit.link/en/mea-poikatsu',
    'https://bsky.app/profile/mea-poikatsu.bsky.social',
  ],
};

---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.operator} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {SITE.gaMeasurementId !== '' && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>
        <script define:vars={{ gaId: SITE.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/mea-code-matome/"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span> {SITE.name}｜紹介コード特集号</a>
        <nav class="main-nav" aria-label="メインナビゲーション">
          <a href="/mea-code-matome/">トップ</a>
          <a href="/mea-code-matome/#summary">特典まとめ一覧</a>
          <a href="/mea-code-matome/#board">みんなの掲示板</a>
          <a href="/mea-code-matome/#point-sites">サービス一覧</a>
          <a href="/mea-code-matome/#faq">よくある質問</a>
          <a href="/mea-code-matome/search/">検索</a>
          <a href="/mea-code-matome/faq/">よくある質問</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="pr-note">
          ※本ページはPR（紹介リンク・アフィリエイト）を含みます。このページの紹介リンク・紹介コード経由で登録し、所定の条件を満たすと、メア（紹介者）に各サービスの運営会社から紹介報酬が支払われる場合があります。紹介報酬が発生しても、利用する方の特典が減ったり料金が上乗せされたりすることはありません。特典額・条件は2026年11月19日時点の各サービス公式キャンペーンに基づきます。最新の条件は各公式ページでご確認ください。紹介コードの無言利用OKです。
        </p>
        <nav class="foot-nav" aria-label="フッターナビゲーション">
          <a href="/mea-code-matome/ad-disclosure/">広告・紹介報酬に関する表記</a>
          <a href="/mea-code-matome/privacy/">プライバシーポリシー</a>
          <a href="/mea-code-matome/terms/">利用規約・免責事項</a>
          <a href="/mea-code-matome/about/">この紹介コードまとめについて</a>
          <a href="/mea-code-matome/contact/">お問い合わせ</a>
          <a href={SITE.hubUrl} target="_blank" rel="noopener">総合案内（ハブ）</a>
        </nav>
        <p class="copyright">© 2026 {SITE.name}｜{SITE.operator}</p>
      </div>
    </footer>
    <script>
      // 紹介コードのコピーボタン（全ページ共通）とGA4クリック計測（CRO_STRATEGY.md §6）
      const gaPageType = (() => {
        const p = location.pathname;
        if (p.includes('/articles/')) return 'article';
        if (p.includes('/service/')) return 'board';
        if (p === '/mea-poikatsu-media/') return 'hub';
        return 'card';
      })();
      const gaServiceFromPath = () => {
        const m = location.pathname.match(/\/(?:articles|service)\/([^/]+)\//);
        return m ? m[1] : '';
      };
      const sendGaEvent = (name: string, params: Record<string, string>) => {
        const w = window as unknown as { gtag?: (type: string, eventName: string, eventParams: Record<string, string>) => void };
        if (typeof w.gtag === 'function') w.gtag('event', name, params);
      };
      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        const anchor = target.closest('a') as HTMLAnchorElement | null;
        if (anchor) {
          const href = anchor.getAttribute('href') || '';
          if (href.includes('mea-keijiban')) {
            sendGaEvent('board_click', { from_site: location.hostname });
          }
          const relTokens = (anchor.getAttribute('rel') || '').split(/\s+/);
          if (relTokens.includes('sponsored')) {
            sendGaEvent('referral_click', { service: anchor.getAttribute('data-service') || gaServiceFromPath(), page_type: gaPageType });
          }
          if (anchor.classList.contains('register-btn') || anchor.classList.contains('btn-primary')) {
            sendGaEvent('cta_click', { service: anchor.getAttribute('data-service') || gaServiceFromPath(), position: anchor.getAttribute('data-position') || 'card' });
          }
        }
        const btn = target.closest('[data-copy]') as HTMLElement | null;
        if (!btn) return;
        const code = btn.getAttribute('data-copy') || '';
        const copied = () => sendGaEvent('code_copy', { service: btn.getAttribute('data-service') || gaServiceFromPath() });
        try {
          await navigator.clipboard.writeText(code);
          copied();
          const label = btn.querySelector('.copy-label');
          if (label) {
            label.textContent = 'コピーしました ✓';
            setTimeout(() => { label.textContent = 'コピー'; }, 2000);
          }
        } catch {
          const ta = document.createElement('textarea');
          ta.value = code;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          copied();
        }
      });
      // 表は横スクロール可能なラッパーで包み、ページ全体の横スクロールを防ぐ
      document.querySelectorAll('main table').forEach((t) => {
        const parent = t.parentElement;
        if (parent && !parent.classList.contains('table-scroll')) {
          const wrap = document.createElement('div');
          wrap.className = 'table-scroll';
          parent.insertBefore(wrap, t);
          wrap.appendChild(t);
        }
      });
    </script>
  </body>
</html>
