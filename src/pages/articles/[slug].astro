---
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import rehypeSponsored from '../../../rehype-sponsored.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE, CATEGORY_NAMES, slugOf } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: slugOf(article.id) }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;

// 記事本文の中段に忍者AdMaxの中段枠（position="middle"）を差し込む（2026-11-21 ユーザー決定）。
// 本文Markdown自体は変更せず、「## 」見出しセクションの半分を過ぎた最初の見出しの直前で分割して描画する。
const mdProcessor = await createMarkdownProcessor({ rehypePlugins: [rehypeSponsored] });
const bodyLines = (article.body ?? '').split('\n');
const headingLineIdxs = bodyLines.map((l, i) => (l.startsWith('## ') ? i : -1)).filter((i) => i >= 0);
let bodyFirst = article.body ?? '';
let bodyRest = '';
if (headingLineIdxs.length >= 2) {
  const cut = headingLineIdxs[Math.floor(headingLineIdxs.length / 2)];
  bodyFirst = bodyLines.slice(0, cut).join('\n');
  bodyRest = bodyLines.slice(cut).join('\n');
}
const firstHtml = (await mdProcessor.render(bodyFirst)).code;
const restHtml = bodyRest ? (await mdProcessor.render(bodyRest)).code : '';

const BOARD_SLUG_MAP: Record<string, string> = {
  freecash: 'freecash', warau: 'warau', hapitas: 'hapitas', moppy: 'moppy',
  tiktok: 'tiktok', 'tiktok-lite': 'tiktok-lite', orikuji: 'orikuji', pokekatsu: 'pokekatsu',
  muse: 'muse', sampo: 'sampo', butamaru: 'butamaru', mirapoi: 'mirapoi',
  tokueru: 'tokueru', dips: 'dips', mercari: 'mercari', paypay: 'paypay',
  airwallet: 'airwallet', 'rakuten-mobile': 'rakuten-mobile', olive: 'smbc-olive',
};
const all = await getCollection('articles');
const related = all.filter((a) => a.data.category === data.category && a.id !== article.id);
const others = all.filter((a) => a.data.category !== data.category && a.id !== article.id).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      inLanguage: 'ja',
      author: { '@type': 'Person', name: SITE.operator },
      dateModified: data.dateModified,
      mainEntityOfPage: `${SITE.siteUrl}/articles/${slugOf(article.id)}/`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '招待コード図鑑 トップ', item: SITE.siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: CATEGORY_NAMES[data.category] ?? data.category, item: `${SITE.siteUrl}/categories/${data.category}/` },
        { '@type': 'ListItem', position: 3, name: data.service, item: `${SITE.siteUrl}/articles/${slugOf(article.id)}/` },
      ],
    },
  ],
};
---

<BaseLayout title={`${data.title}｜${SITE.name}`} description={data.description} canonicalPath={`/articles/${slugOf(article.id)}/`} ogImage={data.image ?? '/images/hero.jpg'} jsonLd={jsonLd}>
  <div class="wrap article-body">
    <p class="breadcrumb"><a href="/mea-code-matome/">トップ</a> › <a href={`/mea-code-matome/categories/${data.category}/`}>{CATEGORY_NAMES[data.category] ?? data.category}</a> › {data.service}</p>

    <h1>{data.title}</h1>
    <p class="article-meta">最終更新：{data.dateModified}{data.verified ? `｜最終確認日：${data.verified}（公式情報）` : ''}｜運営者：{SITE.operator}</p>
    <p class="article-pr">PR｜この記事には紹介リンク・紹介コードを含みます。条件を満たすと紹介者に報酬が支払われる場合があります（利用する方の特典は減りません）。</p>

    <AdSlot position="top" />

    <ServiceCard article={article} detailLink={false} ctaPosition="article_top" headingLevel={2} />

    <div class="article-extra" set:html={firstHtml} />

    {restHtml && <AdSlot position="middle" />}

    {restHtml && <div class="article-extra" set:html={restHtml} />}

    <section class="article-end-cta">
      <h2>{data.service}の特典と紹介コード</h2>
      <div class="benefit-badge">
        <span class="benefit-label">登録者特典</span>
        <span class="benefit-value">{data.benefit}</span>
      </div>
      {data.code ? (
        <div class="code-row">
          <code>{data.code}</code>
          <button class="copy-btn" type="button" data-copy={data.code} data-service={slugOf(article.id)}>
            <span class="copy-label">コピー</span>
          </button>
        </div>
      ) : (
        <p class="conditions">紹介コードはありません。紹介リンクから登録してください。</p>
      )}
      {data.conditions ? (
        <p class="conditions">{data.conditions}</p>
      ) : (
        <p class="conditions">条件・注意事項は上の記事本文で確認してから登録してください。</p>
      )}
      {data.url ? (
        <a class="register-btn" href={data.url} target="_blank" rel="sponsored noopener" data-service={slugOf(article.id)} data-position="article_bottom">
          無料で登録する
        </a>
      ) : data.officialSite ? (
        <a class="register-btn" href={data.officialSite} target="_blank" rel="noopener" data-service={slugOf(article.id)} data-position="article_bottom">
          公式サイトを見る
        </a>
      ) : (
        <p class="conditions">※{data.service}は招待コードのみの紹介です。アプリ・サイト内でコードを入力してください。</p>
      )}
      {BOARD_SLUG_MAP[slugOf(article.id)] && (
        <p><a href={`https://mea-poikatsu.github.io/mea-keijiban/service/${BOARD_SLUG_MAP[slugOf(article.id)]}/`} target="_blank" rel="noopener">みんなのコードも見る（掲示板）</a></p>
      )}
    </section>

    <AdSlot position="bottom" />

    <section class="related">
      <h2>関連記事｜{CATEGORY_NAMES[data.category] ?? data.category}の紹介コード</h2>
      <div class="card-grid">
        {related.map((a) => <ServiceCard article={a} />)}
      </div>
      <h3>ほかのサービスも見る</h3>
      <ul>
        {others.map((a) => (
          <li><a href={`/mea-code-matome/articles/${slugOf(a.id)}/`}>{a.data.service}の紹介コード {a.data.code ?? ''}</a>（{a.data.benefit}）</li>
        ))}
      </ul>
      <p><a href="/mea-code-matome/">トップへ戻る →</a></p>
    </section>
  </div>
</BaseLayout>
