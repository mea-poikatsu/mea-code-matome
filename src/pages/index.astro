---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, CATEGORIES, CATEGORY_NAMES, MATOME_ORDER, FAQS, SISTER_BLOGS, slugOf } from '../data/site';
import { factsOf, SPECIMEN_YEN_OVERRIDE } from '../data/services';

const articles = await getCollection('articles');
const bySlug = new Map(articles.map((a) => [slugOf(a.id), a]));
// 図鑑の並び（おすすめ優先度順）：Freecash→ワラウ→TikTok→TikTok Lite→モッピー→ハピタス→PayPay→メルカリ→エアウォレット→楽天モバイル→オリくじ→ポケカツ→Olive→Muse→サンポ→ぶたまる→ミラポイ→トクエル→dips
// この並びの位置がそのまま標本の通し番号（No.）になる。
const ordered = MATOME_ORDER.map((s) => bySlug.get(s)!).filter(Boolean);
const byCategory = (slug: string) => ordered.filter((a) => a.data.category === slug);

const specimens = ordered.map((a, i) => {
  const slug = slugOf(a.id);
  return {
    article: a,
    slug,
    no: i + 1,
    yen: SPECIMEN_YEN_OVERRIDE[slug] ?? a.data.sortYen ?? 0,
  };
});

const itemList = specimens.map(({ slug, no }) => {
  const f = factsOf(slug);
  return {
    '@type': 'ListItem',
    position: no,
    name: `${f?.name ?? slug} ${f?.code ? `紹介コード ${f.code}` : ''} ${f?.benefit ?? ''}`,
  };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: '紹介コード・招待コードまとめワラウ・ハピタス・モッピー・TikTok・PayPay・楽天モバイル・サンポ・ぶたまる・ミラポイ・トクエル・dipsファーム等の特典一覧｜ポイ活',
      description: SITE.description,
      inLanguage: 'ja',
      dateModified: SITE.dateModified,
    },
    { '@type': 'ItemList', name: '紹介コードまとめ 全19サービス一覧', numberOfItems: 19, itemListElement: itemList },
    {
      '@type': 'FAQPage',
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '招待コード図鑑 トップ', item: SITE.siteUrl + '/' },
      ],
    },
  ],
};

const title = '紹介コード・招待コードまとめワラウ・ハピタス・モッピー・TikTok・PayPay・楽天モバイル・サンポ・ぶたまる・ミラポイ・トクエル・dipsファーム等の特典一覧｜ポイ活';
---

<BaseLayout title={title} description={SITE.description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="wrap">
    <div class="hero">
      <img src="/mea-code-matome/images/hero.jpg" alt="ピンクの背景でメアがポイ活×招待コード×紹介系をお届けするバナー（一緒におトクをGETしよう♡）" width="1179" height="393"  fetchpriority="high"/>
    </div>
<div class="pr-box">
      このページは広告（PR）を含みます。掲載している紹介リンク・紹介コードを使って各サービスに登録し、所定の条件を満たすと、メア（紹介者）に、各サービスの運営会社から紹介報酬が支払われる場合があります。紹介報酬が発生しても、あなたの特典が減ったり、利用料金が上乗せされたりすることはないので安心してね。仕組みと対象範囲は<a href="/mea-code-matome/ad-disclosure/">「広告・紹介報酬に関する表記」</a>にまとめています。
    </div>

    <p class="article-meta">🎀 全19サービス・コードはコピーボタン付き・特典・条件つき／最終更新：2026年11月25日／特典額・条件は各サービスの紹介キャンペーン内容をもとに掲載しているよ♪ キャンペーンは予告なく変更・終了する場合があるから、登録前に公式ページもチェックしてね💡</p>

    <h1>紹介コード・招待コードまとめ💖</h1>
    <p class="lead">
      はじめまして、メアだよ💖 ポイ活の紹介コード・招待コード19サービス分を、図鑑の標本みたいに番号つきで並べたよ✨ 眺めて比べて、気になる標本のコードをコピーして、ボタンから登録するだけ！ 一緒におトクをGETしようね♪
    </p>

    <ul class="badges">
      <li>🎀 全19サービス</li>
      <li>📋 コードはコピーボタン付き</li>
      <li>🎁 特典・条件つき</li>
    </ul>

    <section id="specimens" class="specimen-section">
      <h2>標本グリッド｜全19サービス</h2>
      <p>全19サービスを標本カードで並べたよ。番号（No.）はメアのおすすめ順。分類で絞り込んだり、特典額の大きい順に並べ替えたりできるよ♪</p>

      <div class="specimen-controls">
        <div class="specimen-filters" role="group" aria-label="分類で絞り込み">
          <button type="button" class="specimen-chip is-active" data-filter-cat="all">すべて</button>
          {CATEGORIES.map((c) => (
            <button type="button" class="specimen-chip" data-filter-cat={c.slug}>{c.name}</button>
          ))}
        </div>
        <label class="specimen-sort">
          並べ替え
          <select id="specimen-sort-select">
            <option value="no" selected>図鑑番号順（おすすめ順）</option>
            <option value="yen">特典額順（大きい順）</option>
          </select>
        </label>
        <p class="specimen-count" id="specimen-count" aria-live="polite">全19件を表示中</p>
      </div>

      <div class="specimen-grid" id="specimen-grid">
        {specimens.map((s) => (
          <SpecimenCard article={s.article} no={s.no} yen={s.yen} />
        ))}
      </div>
    </section>

    <div class="board-promo">
      <p>💬 あなたの紹介コードも投稿できる「ポイ活ひろば」があるよ♪</p>
      <p><a class="register-btn" href={SITE.boardUrl} target="_blank" rel="noopener">掲示板へ行く →</a></p>
      <p class="note">ポイ活ひろばは公開中です。</p>
    </div>

    <AdSlot position="top" />

    <h2 id="board">ポイ活ひろば</h2>
    <p>メアの掲示板では、あなたの紹介コードも投稿できるよ。ほかの人のコードも見られるから、気になるサービスを探すのにも便利だよ♪</p>
    <ul>
      <li>✅ 19サービス＋その他の紹介コードが投稿できるよ</li>
      <li>✅ あなたのコードも投稿できるよ</li>
      <li>✅ URL・個人情報らしい投稿は自動でブロックされるよ</li>
    </ul>
    <p>掲示板のルール：紹介コードの投稿は、紹介コード投稿が許可されている掲示板でのみ行ってね。URLや個人情報が入った投稿は自動でブロックされるよ。同じコードの短時間での再投稿もブロックされるよ。</p>
    <p><a class="register-btn" href={SITE.boardUrl} target="_blank" rel="noopener">掲示板へ行く →</a></p>
    <p class="note">ポイ活ひろばは公開中です。</p>

    <AdSlot position="middle" />

    <h2 id="howto">使い方はかんたん3ステップだよ✨</h2>
    <ol class="steps">
      <li><strong>サービスを選ぶ</strong> — 上の標本グリッドから、気になるサービスを見つけてね♪</li>
      <li><strong>コードをコピーする</strong> — 標本ラベルの横の「コピー」ボタンを押すだけ！ 手入力はいらないよ◎</li>
      <li><strong>ボタンから登録する</strong> — ピンクのボタンを押して登録してね。コードの入力欄があったら貼り付けてね♡</li>
    </ol>

    <h2 id="faq">よくある質問💡</h2>
    {FAQS.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
    <p><a href="/mea-code-matome/faq/">よくある質問の一覧を見る →</a></p>

    <h2>ご利用にあたっての注意</h2>
    <ul>
      <li>特典・条件は各サービスの紹介キャンペーン内容をもとに掲載しています。キャンペーンは予告なく変更・終了する場合があります。</li>
      <li>登録前に、各サービスの公式ページで最新の条件を確認してください。</li>
      <li>紹介コード・紹介リンクの利用は無料です。紹介を使っても、利用する方に追加の料金はかかりません。</li>
    </ul>

    <h2 id="sisters">メアのほかのブログも見てみてね♡</h2>
    <p>同じ紹介コードを、ちがう見た目・使い方で紹介しているメアのブログだよ♪ お好みのページで見てね！</p>
    <ul>
      {SISTER_BLOGS.map((b) => (
        <li><a href={b.url} target="_blank" rel="noopener">{b.name}</a>：{b.note}</li>
      ))}
    </ul>

    <h2>📂 カテゴリー</h2>
    <ul>
      {CATEGORIES.map((c) => (
        <li><a href={`/mea-code-matome/categories/${c.slug}/`}>{c.name}</a>（{byCategory(c.slug).length}）</li>
      ))}
    </ul>

    <h2>🌐 全媒体の入口</h2>
    <p><a href={SITE.hubUrl} target="_blank" rel="noopener">ポイ活ポータル（トップページ）</a> — ホームページ・ブログ・掲示板・note・Xなど、メアの媒体はここからたどれます♪</p>

    <h2>🎀 この紹介コードまとめについて</h2>
    <p>ポイ活大好きなメアが、実際に使っている紹介コードだけを、図鑑みたいに眺めて比べやすいようにまとめたページだよ💖 特典額や条件が変わったら随時更新していくね♪</p>
    <p><a href="/mea-code-matome/about/">運営者情報を見る →</a></p>

    <AdSlot position="bottom" />
  </div>

  <script>
    // 標本グリッドの絞り込み（分類）と並べ替え（図鑑番号順／特典額順）。JS無効時も全標本がそのまま見える。
    (() => {
      const grid = document.getElementById('specimen-grid');
      const count = document.getElementById('specimen-count');
      const sortSelect = document.getElementById('specimen-sort-select') as HTMLSelectElement | null;
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]'));
      if (!grid) return;
      const items = Array.from(grid.querySelectorAll<HTMLElement>('.specimen'));
      let cat = 'all';
      const apply = () => {
        const mode = sortSelect?.value ?? 'no';
        const sorted = [...items].sort((a, b) => {
          if (mode === 'yen') {
            const d = Number(b.dataset.yen || 0) - Number(a.dataset.yen || 0);
            return d !== 0 ? d : Number(a.dataset.no || 0) - Number(b.dataset.no || 0);
          }
          return Number(a.dataset.no || 0) - Number(b.dataset.no || 0);
        });
        sorted.forEach((el) => grid.appendChild(el));
        let visible = 0;
        items.forEach((el) => {
          const show = cat === 'all' || el.dataset.category === cat;
          el.style.display = show ? '' : 'none';
          if (show) visible += 1;
        });
        if (count) count.textContent = `全${items.length}件中 ${visible}件を表示中`;
      };
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          cat = chip.getAttribute('data-filter-cat') || 'all';
          apply();
        });
      });
      sortSelect?.addEventListener('change', apply);
      apply();
    })();
  </script>
</BaseLayout>
