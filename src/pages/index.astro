---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, CATEGORIES, CATEGORY_NAMES, MATOME_ORDER, FAQS, SISTER_BLOGS, slugOf } from '../data/site';

const articles = await getCollection('articles');
const bySlug = new Map(articles.map((a) => [slugOf(a.id), a]));
// 旧サイトの一覧表の並び（ワラウ→ハピタス→モッピー→TikTok→TikTok Lite→PayPay→メルカリ→エアウォレット→楽天モバイル→オリくじ→ポケカツ→Freecash→Olive→Muse→サンポ→ぶたまる→ミラポイ→トクエル→dips）
const ordered = MATOME_ORDER.map((s) => bySlug.get(s)!).filter(Boolean);
const byCategory = (slug: string) => ordered.filter((a) => a.data.category === slug);

const itemList = ordered.map((a, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: `${a.data.service} ${a.data.code ? `紹介コード ${a.data.code}` : ''} ${a.data.benefit}`,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: '紹介コード・招待コードまとめワラウ・ハピタス・モッピー・TikTok・PayPay・楽天モバイル・サンポ・ぶたまる・ミラポイ・トクエル・dipsファーム等の特典一覧｜ポイ活',
      description: SITE.description,
      inLanguage: 'ja',
      dateModified: SITE.dateModified,
    },
    { '@type': 'ItemList', name: '紹介コードまとめ 全19サービス一覧', numberOfItems: 19, itemListElement: itemList },
    {
      '@type': 'FAQPage',
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '紹介コードまとめブログ トップ', item: SITE.siteUrl + '/' },
      ],
    },
  ],
};

const title = '紹介コード・招待コードまとめワラウ・ハピタス・モッピー・TikTok・PayPay・楽天モバイル・サンポ・ぶたまる・ミラポイ・トクエル・dipsファーム等の特典一覧｜ポイ活';
const categoryHeadings: Record<string, string> = {
  'point-sites': 'ポイントサイトの紹介コード（ワラウ・ハピタス・モッピー）',
  'sns-video': 'TikTok・TikTok Liteの招待コード（SNS・動画系）',
  payment: '決済・キャッシュレスの紹介コード（PayPay・メルカリ・エアウォレット）',
  other: 'その他の紹介コード・招待コード（楽天モバイル・SMBC Oliveほか）',
};
---

<BaseLayout title={title} description={SITE.description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="wrap">
    <div class="hero">
      <img src="/mea-code-matome/images/hero.jpg" alt="ピンクの背景でメアがポイ活×招待コード×紹介系をお届けするバナー（一緒におトクをGETしよう♡）" width="1179" height="393"  fetchpriority="high"/>
    </div>
<p class="pace-banner">🌱1ヶ月 約5万円ペースで貯まるよ♡</p>
<style>
  .pace-banner { margin: 14px 0 6px; padding: 12px 16px; border-radius: 999px; background: linear-gradient(90deg, #d81b60, #ad1457); color: #fff; font-weight: 800; font-size: clamp(1.05rem, 3.6vw, 1.45rem); text-align: center; letter-spacing: 0.02em; box-shadow: 0 4px 14px rgba(216, 27, 96, 0.35); }
</style>
<div class="pr-box">
      このページは広告（PR）を含みます。掲載している紹介リンク・紹介コードを使って各サービスに登録し、所定の条件を満たすと、メア（紹介者）に、各サービスの運営会社から紹介報酬が支払われる場合があります。紹介報酬が発生しても、あなたの特典が減ったり、利用料金が上乗せされたりすることはないので安心してね。仕組みと対象範囲は<a href="/mea-code-matome/ad-disclosure/">「広告・紹介報酬に関する表記」</a>にまとめています。
    </div>

    <p class="article-meta">🎀 全19サービス・コードはコピーボタン付き・特典・条件つき／最終更新：2026年11月19日／特典額・条件は各サービスの紹介キャンペーン内容をもとに掲載しているよ♪ キャンペーンは予告なく変更・終了する場合があるから、登録前に公式ページもチェックしてね💡</p>

    <h1>紹介コード・招待コードまとめ💖</h1>
    <p class="lead">
      はじめまして、メアだよ💖 ポイ活の紹介コード・招待コードを19サービス分まとめて掲載しているよ✨ 一覧表で特典を比べたら、気になるサービスのコードをコピーして、ボタンから登録するだけ！ 一緒におトクをGETしようね♪
    </p>

    <ul class="badges">
      <li>🎀 全19サービス</li>
      <li>📋 コードはコピーボタン付き</li>
      <li>🎁 特典・条件つき</li>
    </ul>

    <div class="board-promo">
      <p>💬 あなたの紹介コードも投稿できる「みんなの紹介コード掲示板」があるよ♪</p>
      <p><a class="register-btn" href={SITE.boardUrl} target="_blank" rel="noopener">掲示板へ行く →</a></p>
      <p class="note">みんなの紹介コード掲示板は公開中です。</p>
    </div>

    <AdSlot position="top" />

    <h2 id="summary">全19サービス比較</h2>
    <p>特典・紹介コード・登録リンクを一覧で比較できるよ。サービス名を押すと下のカードへ移動するよ♪</p>
    <table class="ranking-table">
      <thead>
        <tr>
          <th>サービス名</th>
          <th>特典</th>
          <th>紹介コード</th>
          <th>登録</th>
        </tr>
      </thead>
      <tbody>
        {ordered.map((a) => (
          <tr>
            <td><a href={`#${slugOf(a.id)}`}>{a.data.service}</a></td>
            <td>{a.data.benefit}</td>
            <td>
              {a.data.code ? (
                <>
                  <code>{a.data.code}</code>
                  <button class="copy-btn" type="button" data-copy={a.data.code}>
                    <span class="copy-label">コピー</span>
                  </button>
                </>
              ) : (
                'コードなし（リンク型）'
              )}
            </td>
            <td>
              {a.data.url ? (
                <a class="register-btn" href={a.data.url} target="_blank" rel="sponsored noopener">
                  {a.data.service === 'SMBC Olive（三井住友銀行）' ? 'エントリー' : '登録する'}
                </a>
              ) : a.data.officialSite ? (
                <a class="register-btn" href={a.data.officialSite} target="_blank" rel="noopener">公式サイト</a>
              ) : (
                'コードのみ'
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 id="board">みんなの紹介コード掲示板</h2>
    <p>メアの掲示板では、あなたの紹介コードも投稿できるよ。ほかの人のコードも見られるから、気になるサービスを探すのにも便利だよ♪</p>
    <ul>
      <li>✅ 19サービス＋その他の紹介コードが投稿できるよ</li>
      <li>✅ あなたのコードも投稿できるよ</li>
      <li>✅ URL・個人情報らしい投稿は自動でブロックされるよ</li>
    </ul>
    <p>掲示板のルール：紹介コードの投稿は、紹介コード投稿が許可されている掲示板でのみ行ってね。URLや個人情報が入った投稿は自動でブロックされるよ。同じコードの短時間での再投稿もブロックされるよ。</p>
    <p><a class="register-btn" href={SITE.boardUrl} target="_blank" rel="noopener">掲示板へ行く →</a></p>
    <p class="note">みんなの紹介コード掲示板は公開中です。</p>

    {CATEGORIES.map((c) => (
      <>
        <h2 id={c.slug}>{categoryHeadings[c.slug] ?? CATEGORIES.find((x) => x.slug === c.slug)?.name}</h2>
        <div class="card-grid">
          {byCategory(c.slug).map((a) => (
            <ServiceCard article={a} />
          ))}
        </div>
      </>
    ))}

    <AdSlot position="middle" />

    <h2 id="howto">使い方はかんたん3ステップだよ✨</h2>
    <ol class="steps">
      <li><strong>サービスを選ぶ</strong> — 上の一覧表から、気になるサービスを見つけてね♪</li>
      <li><strong>コードをコピーする</strong> — 黒い枠の横の「コピー」ボタンを押すだけ！ 手入力はいらないよ◎</li>
      <li><strong>ボタンから登録する</strong> — ピンクのボタンを押して登録してね。コードの入力欄があったら貼り付けてね♡</li>
    </ol>

    <h2 id="faq">よくある質問💡</h2>
    {FAQS.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
    <p><a href="/mea-code-matome/faq/">よくある質問の一覧を見る →</a></p>

    <h2>ご利用にあたっての注意</h2>
    <ul>
      <li>特典・条件は各サービスの紹介キャンペーン内容をもとに掲載しています。キャンペーンは予告なく変更・終了する場合があります。</li>
      <li>登録前に、各サービスの公式ページで最新の条件を確認してください。</li>
      <li>紹介コード・紹介リンクの利用は無料です。紹介を使っても、利用する方に追加の料金はかかりません。</li>
    </ul>

    <h2 id="sisters">メアのほかのブログも見てみてね♡</h2>
    <p>同じ紹介コードを、ちがう見た目・使い方で紹介しているメアのブログだよ♪ お好みのページで見てね！</p>
    <ul>
      {SISTER_BLOGS.map((b) => (
        <li><a href={b.url} target="_blank" rel="noopener">{b.name}</a>：{b.note}</li>
      ))}
    </ul>

    <h2>📂 カテゴリー</h2>
    <ul>
      {CATEGORIES.map((c) => (
        <li><a href={`/mea-code-matome/categories/${c.slug}/`}>{c.name}</a>（{byCategory(c.slug).length}）</li>
      ))}
    </ul>

    <h2>🌐 全媒体の入口</h2>
    <p><a href={SITE.hubUrl} target="_blank" rel="noopener">メアのポイ活メディア（トップページ）</a> — ホームページ・ブログ・掲示板・note・Xなど、メアの媒体はここからたどれます♪</p>

    <h2>🎀 この紹介コードまとめについて</h2>
    <p>ポイ活大好きなメアが、実際に使っている紹介コードだけを、一覧表で比べやすいようにまとめたページだよ💖 特典額や条件が変わったら随時更新していくね♪</p>
    <p><a href="/mea-code-matome/about/">運営者情報を見る →</a></p>

    <AdSlot position="bottom" />
  </div>
</BaseLayout>
